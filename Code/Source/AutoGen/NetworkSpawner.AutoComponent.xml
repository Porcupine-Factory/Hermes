<?xml version="1.0"?>

<Component
    Name="NetworkSpawner"
    Namespace="Hermes"
    OverrideComponent="false"
    OverrideController="true"
    OverrideInclude="Multiplayer/NetworkSpawner.h"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <NetworkProperty Type="bool" Name="EnableNetworkSpawner"
                     Init="true" ReplicateFrom="Authority"
                     ReplicateTo="Client" IsRewindable="false"
                     IsPredictable="false" IsPublic="true"
                     Container="Object" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="Determines whether NetworkSpawner is enabled or disabled."/>
    <NetworkProperty Type="AZStd::pair&lt;uint32_t,AZ::u64&gt;" Name="LastSpawnedTicketIdByEntityId"
                     Init="AZStd::pair&lt;uint32_t,AZ::u64&gt;()" ReplicateFrom="Authority"
                     ReplicateTo="Client" IsRewindable="false"
                     IsPredictable="false" IsPublic="true"
                     Container="Object" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="The TicketId of the most recently spawned prefab using Spawner and the EntityId that triggered the spawn."/>
    <NetworkProperty Type="uint32_t" Name="LastSpawnedTicketId"
                     Init="0" ReplicateFrom="Authority"
                     ReplicateTo="Client" IsRewindable="false"
                     IsPredictable="false" IsPublic="true"
                     Container="Object" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="The TicketId of the most recently spawned prefab using Spawner."/>
    <NetworkProperty Type="AZ::u64" Name="ServerEntityIdCausedLastSpawn"
                     Init="0" ReplicateFrom="Authority"
                     ReplicateTo="Client" IsRewindable="false"
                     IsPredictable="false" IsPublic="true"
                     Container="Object" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="The server EntityId that caused the last spawn."/>
    <NetworkProperty Type="AZStd::vector&lt;AZ::u64&gt;" Name="LastSpawnedServerEntityIds"
                     Init="AZStd::vector&lt;AZ::u64&gt;()" ReplicateFrom="Authority"
                     ReplicateTo="Client" IsRewindable="false"
                     IsPredictable="false" IsPublic="true"
                     Container="Object" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="The EntityIds of the most recently spawned prefab using Spawner."/>
    <NetworkProperty Type="uint32_t" Name="LastDespawnedTicketId"
                     Init="0" ReplicateFrom="Authority"
                     ReplicateTo="Client" IsRewindable="false"
                     IsPredictable="false" IsPublic="true"
                     Container="Object" ExposeToEditor="false"
                     ExposeToScript="true" GenerateEventBindings="true"
                     Description="The TicketId of the most recently despawned prefab using Spawner."/>

    <RemoteProcedure Name="SpawnPrefabName" InvokeFrom="Autonomous" HandleOn="Authority" IsPublic="true" IsReliable="true" GenerateEventBindings="true" Description="Spawn a prefab using a name given by an autonomous client">
        <Param Type="AZStd::string" Name="PrefabName"/>
        <Param Type="AZ::Transform" Name="Transform"/>
        <Param Type="bool" Name="MakeChild"/>
    </RemoteProcedure>
    <RemoteProcedure Name="SpawnPrefabPath" InvokeFrom="Autonomous" HandleOn="Authority" IsPublic="true" IsReliable="true" GenerateEventBindings="true" Description="Spawn a prefab using a path given by an autonomous client">
        <Param Type="AZStd::string" Name="PrefabPath"/>
        <Param Type="AZ::Transform" Name="Transform"/>
        <Param Type="bool" Name="MakeChild"/>
    </RemoteProcedure>
    <RemoteProcedure Name="DepawnPrefabTicketId" InvokeFrom="Autonomous" HandleOn="Authority" IsPublic="true" IsReliable="true" GenerateEventBindings="true" Description="Despawn the prefab associated with a TicketId given by an autonomous client">
        <Param Type="uint32_t" Name="PrefabTicketId"/>
    </RemoteProcedure>

</Component>
